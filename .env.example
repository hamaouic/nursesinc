# Web3Forms access key — get yours at https://web3forms.com (free, no signup).
# Put the same value in Cloudflare Pages → Settings → Environment variables
# so the form actually sends email when deployed.
VITE_WEB3FORMS_KEY=your-access-key-here

# Auto-reply Worker URL — the Cloudflare Worker that sends a branded
# thank-you email back to the visitor after they submit. After running
# `wrangler deploy` inside /worker, set this to the *.workers.dev URL
# Cloudflare prints, e.g.
#   VITE_AUTO_REPLY_URL=https://nursesinc-auto-reply.<account>.workers.dev
VITE_AUTO_REPLY_URL=
