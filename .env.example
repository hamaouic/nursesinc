# Web3Forms access key — get yours at https://web3forms.com (free, no signup).
# Put the same value in Cloudflare Pages → Settings → Environment variables
# so the form actually sends email when deployed.
VITE_WEB3FORMS_KEY=your-access-key-here

# Booking email delivery mode.
#   'mock' (default) — emails are kept in the in-memory inbox visible on
#                       the /services?admin=true dashboard; nothing is sent.
#   'live'            — posts to /api/booking/notify (a Cloudflare Pages
#                       Function) which forwards to Resend. Requires:
#                         RESEND_API_KEY       (Cloudflare secret, encrypted)
#                         RESEND_FROM_EMAIL    (verified sender, e.g. cathamaoui@hotmail.com)
#                         RESEND_NURSE_EMAIL   (defaults to cathamaoui@hotmail.com)
# Put this in Cloudflare Pages → Settings → Environment variables.
VITE_BOOKING_MODE=mock
