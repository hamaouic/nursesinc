# ----------------------------------------------------------------------
# Web3Forms access key — get yours at https://web3forms.com (free, no signup).
# Register cathamaoui@hotmail.com as the destination inbox for this key.
# Used by:
#   - /contact form (live contact submissions)
#   - /services booking form (when VITE_BOOKING_MODE=web3forms)
# Put this value in Cloudflare Pages → Settings → Environment variables
# so the site actually sends email when deployed.
# ----------------------------------------------------------------------
VITE_WEB3FORMS_KEY=your-access-key-here

# ----------------------------------------------------------------------
# Booking email delivery mode
#   'mock' (default)
#       All emails stay in the in-memory inbox visible at
#       /services?admin=true. Nothing is sent. Zero configuration.
#
#   'web3forms'
#       Posts to https://api.web3forms.com/submit using the
#       VITE_WEB3FORMS_KEY above. No DNS work; Web3Forms forwards to the
#       inbox tied to that access key. Free tier ~250 emails/mo.
#       Set this when you want real emails without buying a domain.
#
#   'live'
#       Posts to /api/booking/notify (Cloudflare Function) which forwards
#       to Resend. Requires a Resend-verified domain (SPF + DKIM DNS).
#       Set this when you own a domain (e.g. nursesinc.ca).
#       Required Cloudflare secrets (all marked Encrypt):
#           RESEND_API_KEY
#           RESEND_FROM_EMAIL    (verified sender)
#           RESEND_NURSE_EMAIL   (defaults to cathamaoui@hotmail.com)
# ----------------------------------------------------------------------
VITE_BOOKING_MODE=mock
